{
  "name": "dsh-architecture-map",
  "version": "0.3.0",
  "description": "Architecture map for DeepSeek Harness: a semantic architecture graph with per-node side conversations, incremental architecture memory and read-only remote repositories over SSH.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "architecture",
    "diagram",
    "subagent",
    "ssh",
    "remote"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check src/host/plugin.js && node --check src/host/graph.js && node --check src/host/memory.js && node --check src/host/export.js && node --check src/host/signature.js && node --check scripts/remote-smoke.mjs",
    "test": "node --test",
    "remote-smoke": "node scripts/remote-smoke.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "skills",
    "vendor",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/DETAIL.md",
    "docs/DETAIL.zh.md",
    "CHANGELOG.md",
    "docs/preview.svg",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yyf-424/dsh-architecture-map.git"
  },
  "homepage": "https://github.com/yyf-424/dsh-architecture-map#readme",
  "bugs": {
    "url": "https://github.com/yyf-424/dsh-architecture-map/issues"
  }
}
